# ====================================
# 5ちゃんねるまとめブログ自動投稿ツール 設定ファイル
# ====================================
# このファイルをコピーして実際の値を設定してください
# 注意: このファイルはGitにコミットしないでください

# ====================================
# Livedoor Blog API 設定
# ====================================
# ライブドアブログのユーザーID（ブログのサブドメイン部分）
LIVEDOOR_BLOG_ID=your_blog_id_here

# AtomPub API用のAPIキー
# 管理画面 → 設定 → APIキー から取得可能
LIVEDOOR_API_KEY=your_api_key_here

# ブログのエンドポイント（通常は変更不要）
LIVEDOOR_ENDPOINT=https://livedoor.blogcms.jp/atompub

# ====================================
# 投稿設定
# ====================================
# 投稿状態: draft（下書き）または publish（公開）
POST_STATUS=draft

# デフォルトのカテゴリ（空白可）
DEFAULT_CATEGORY=まとめ

# ====================================
# スクレイピング設定
# ====================================
# リクエスト間隔（秒）- サーバー負荷軽減のため
REQUEST_DELAY=1.0

# User-Agent（5chアクセス用）
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
