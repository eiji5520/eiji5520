{
  "name": "xboard",
  "version": "1.0.0",
  "description": "XBoard - X(Twitter) Multi-Account Desktop Manager",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "webpack serve --config webpack.renderer.config.js --mode development",
    "dev:main": "webpack --config webpack.main.config.js --mode development && electron .",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build:main": "webpack --config webpack.main.config.js --mode production",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.xboard.app",
    "productName": "XBoard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "target": ["dmg", "zip"],
      "minimumSystemVersion": "14.0"
    },
    "win": {
      "target": ["nsis", "portable"],
      "minimumOSVersion": "10.0.22000"
    }
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:39413/git/eiji5520/eiji5520"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.6.2",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "jszip": "^3.10.1",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.6",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  }
}
