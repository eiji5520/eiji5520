{
  "name": "insta-automation-app",
  "version": "1.0.0",
  "description": "Instagram automation desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^5.3.0",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^25.3.0",
    "electron-builder": "^23.6.0"
  },
  "build": {
    "appId": "com.example.instaautomation",
    "files": ["**/*"],
    "extraResources": [
      {
        "from": "python/",
        "to": "python",
        "filter": ["**/*"]
      }
    ],
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}
